# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development
PORT=5000

# Google Cloud Speech-to-Text API (optional)
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_SPEECH_API_KEY=your-google-speech-api-key-here

# Database Configuration (for production)
# DATABASE_URL=postgresql://user:password@localhost/therapist_db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=therapist.log

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
RATE_LIMIT_PER_MINUTE=60

# Voice Configuration
VOICE_ENABLED=true
VOICE_LANGUAGE=en
VOICE_RATE=150

# Crisis Detection Configuration
CRISIS_DETECTION_ENABLED=true
EMERGENCY_CONTACTS_ENABLED=true